-- === MAIN PROCESS ===
local function MainProcess()
    LoadBlacklist()
    SelectTeam()
    CreateUI()
    UpdateStatus("✅ Ready (" .. collectedCount .. " collected)", Color3.fromRGB(0, 255, 0))
    
    while task.wait(CONFIG.ScanInterval) do
        UpdateStatus("🔍 Scanning for fruits...", Color3.fromRGB(255, 255, 0))
        local found = ScanFruits()
        
        if found > 0 then
            UpdateStatus("📦 Storing fruits... (" .. found .. " found)", Color3.fromRGB(0, 200, 255))
            local stored = StoreFruits()
            
            if #stored > 0 then
                for _, fruitName in ipairs(stored) do
                    if not table.find(fruitLog, fruitName) then
                        table.insert(fruitLog, fruitName)
                        collectedCount = collectedCount + 1
                        SendWebhook(fruitName)
                    end
                end
                UpdateStatus("✅ Collected " .. #stored .. " fruit(s)", Color3.fromRGB(0, 255, 0))
            else
                UpdateStatus("❌ No Fruit", Color3.fromRGB(255, 100, 100))
            end
        else
            UpdateStatus("❌ No Fruit", Color3.fromRGB(255, 100, 100))
        end
        
        task.wait(CONFIG.HopDelay - CONFIG.ScanInterval)
        
        UpdateStatus("🔄 Preparing to hop...", Color3.fromRGB(255, 200, 0))
        AutoHop()
        
        task.wait(2)
    end
end

pcall(MainProcess)
