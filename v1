local function GetRequest()
    return (syn and syn.request)
        or (http and http.request)
        or http_request
        or request
end

local function GetServerList()
    local servers = {}
    local req = GetRequest()

    if not req then
        warn("[ServerHop] Executor không có HTTP request function")
        return servers
    end

    local cursor = nil
    local maxPages = 5

    for _ = 1, maxPages do
        local url =
            "https://games.roblox.com/v1/games/"
            .. game.PlaceId
            .. "/servers/Public?sortOrder=Asc&limit=100"

        if cursor then
            url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
        end

        local ok, response = pcall(function()
            return req({
                Url = url,
                Method = "GET",
                Headers = {
                    ["Content-Type"] = "application/json"
                }
            })
        end)

        if not ok or not response then
            warn("[ServerHop] Request failed:", response)
            break
        end

        local body = response.Body or response.body

        if not body then
            warn("[ServerHop] Response không có Body")
            break
        end

        local decodeOk, data = pcall(function()
            return HttpService:JSONDecode(body)
        end)

        if not decodeOk or not data then
            warn("[ServerHop] JSON decode failed:", data)
            break
        end

        if data.data then
            for _, server in ipairs(data.data) do
                if server.id
                    and server.id ~= game.JobId
                    and server.playing
                    and server.maxPlayers
                then
                    table.insert(servers, {
                        id = server.id,
                        count = server.playing,
                        max = server.maxPlayers
                    })
                end
            end
        end

        cursor = data.nextPageCursor

        if not cursor then
            break
        end

        task.wait(0.15)
    end

    return servers
end


local function IsBlacklisted(serverId)
    return table.find(blacklist, serverId) ~= nil
end

local function AddToBlacklist(serverId)
    if not serverId or serverId == "" then
        return
    end

    if IsBlacklisted(serverId) then
        return
    end

    -- Đủ 30 server thì clear TOÀN BỘ
    if #blacklist >= CONFIG.MaxBlacklist then
        blacklist = {}
        SaveBlacklist()
        print("[ServerHop] Blacklist full -> cleared")
    end

    table.insert(blacklist, serverId)

    -- Lưu xuống file thật
    SaveBlacklist()

    print(
        "[ServerHop] Blacklisted:",
        serverId,
        "(" .. #blacklist .. "/" .. CONFIG.MaxBlacklist .. ")"
    )
end


local function TeleportToServer(serverId)
    if not serverId or serverId == "" then
        return false
    end

    if isTeleporting then
        return false
    end

    if IsBlacklisted(serverId) then
        warn("[ServerHop] Target is blacklisted:", serverId)
        return false
    end

    isTeleporting = true
    pendingHopServer = serverId

    UpdateStatus(
        "🚀 Hopping...",
        Color3.fromRGB(255, 100, 100)
    )

    local success, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(
            game.PlaceId,
            serverId,
            plr
        )
    end)

    if not success then
        warn("[ServerHop] Teleport call failed:", err)

        -- Bảo hộ: server teleport lỗi ngay lập tức
        AddToBlacklist(serverId)

        pendingHopServer = nil
        isTeleporting = false

        UpdateStatus(
            "❌ Hop failed",
            Color3.fromRGB(255, 80, 80)
        )

        return false
    end

    return true
end

TeleportService.TeleportInitFailed:Connect(function(
    teleportPlayer,
    teleportResult,
    errorMessage
)
    if teleportPlayer ~= plr then
        return
    end

    if not pendingHopServer then
        return
    end

    local failedServer = pendingHopServer

    warn(
        "[ServerHop] Teleport failed:",
        failedServer,
        teleportResult,
        errorMessage
    )

    -- Server full / chết / teleport lỗi
    AddToBlacklist(failedServer)

    pendingHopServer = nil
    isTeleporting = false

    UpdateStatus(
        "⚠️",
        Color3.fromRGB(255, 150, 0)
    )

    -- Fallback đúng 1 lần, không queue
    task.delay(0.5, function()
        if isTeleporting then
            return
        end

        local target = GetRandomAvailableServer()

        if not target then
            return
        end

        print(
            "[ServerHop] Fallback:",
            target.id,
            target.count .. "/" .. target.max
        )

        TeleportToServer(target.id)
    end)
end)


local function GetRandomAvailableServer()
    local allServers = GetServerList()

    if #allServers == 0 then
        warn("[ServerHop] No server list")
        return nil
    end

    local candidates = {}

    for _, server in ipairs(allServers) do
        if server.id
            and server.id ~= game.JobId
            and not IsBlacklisted(server.id)
            and server.count < server.max
        then
            table.insert(candidates, server)
        end
    end

    if #candidates == 0 then
        return nil
    end

    -- Không queue, chỉ lấy 1 server
    return candidates[math.random(1, #candidates)]
end


local function HopServer()
    if isTeleporting then
        return false
    end

    UpdateStatus(
        "🔍 Finding server...",
        Color3.fromRGB(255, 200, 0)
    )

    local target = GetRandomAvailableServer()

    if not target then
        UpdateStatus(
            "❌ No available server",
            Color3.fromRGB(255, 80, 80)
        )

        return false
    end

    -- Blacklist server hiện tại trước khi rời
    if game.JobId and game.JobId ~= "" then
        AddToBlacklist(game.JobId)
    end

    print(
        "[ServerHop] Target:",
        target.id,
        target.count .. "/" .. target.max
    )

    return TeleportToServer(target.id)
end

