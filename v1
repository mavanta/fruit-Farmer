local function SendWebhook(fruitName)
    if getgenv().WebhookUrl == "" then return end
    
    local embed = {
        ["embeds"] = {{
            ["title"] = "🍎 Fruit Collected",
            ["color"] = 0xFF0000,
            ["fields"] = {
                {["name"] = "Fruit", ["value"] = "```" .. fruitName .. "```", ["inline"] = true},
                {["name"] = "Player", ["value"] = "```" .. plr.Name .. "```", ["inline"] = true},
                {["name"] = "JobID", ["value"] = "```" .. game.JobId .. "```", ["inline"] = false}
            },
            ["footer"] = {["text"] = "discord.gg/mSrMzVuc3h"},
            ["timestamp"] = os.date("!%Y-%m-%dT%TZ")
        }}
    }
    
    pcall(function()
        HttpService:PostAsync(getgenv().WebhookUrl, HttpService:JSONEncode(embed), Enum.HttpContentType.ApplicationJson)
    end)
end

