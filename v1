-- === FILE SYSTEM (Delta) ===
local function SaveBlacklist()
    pcall(function()
        if writefile then
            local data = table.concat(blacklist, "\n")
            writefile(CONFIG.BlacklistFile, data)
        end
    end)
end

local function LoadBlacklist()
    pcall(function()
        if isfile and isfile(CONFIG.BlacklistFile) then
            if readfile then
                local content = readfile(CONFIG.BlacklistFile)
                if content and content ~= "" then
                    blacklist = {}
                    for line in string.gmatch(content, "[^\n]+") do
                        if line ~= "" then
                            table.insert(blacklist, line)
                        end
                    end
                    -- Giới hạn số lượng
                    if #blacklist > CONFIG.MaxBlacklist then
                        local keep = {}
                        for i = #blacklist - CONFIG.MaxBlacklist + 1, #blacklist do
                            table.insert(keep, blacklist[i])
                        end
                        blacklist = keep
                        SaveBlacklist()
                    end
                end
            end
        end
    end)
end

local function ClearBlacklist()
    pcall(function()
        blacklist = {}
        if writefile then
            writefile(CONFIG.BlacklistFile, "")
        end
    end)
end

-- === AUTO TEAM (click chuột ảo - từ script kia) ===
local function SelectTeam()
    pcall(function()
        if not game:IsLoaded() then
            game.Loaded:Wait()
        end
        task.wait(3)
        
        local realteam = _G.autoteam or "Pirates"
        local pg = plr:WaitForChild("PlayerGui")
        local mainmal = pg:WaitForChild("Main (minimal)")
        local chooseteambtn = mainmal.ChooseTeam.Container[realteam].Frame.TextButton
        
        repeat
            task.wait()
        until chooseteambtn.AbsoluteSize.X > 0 and chooseteambtn.AbsoluteSize.Y > 0
        
        local inset = GuiService:GetGuiInset()
        local pos = chooseteambtn.AbsolutePosition
        local size = chooseteambtn.AbsoluteSize
        local x = pos.X + size.X / 2
        local y = pos.Y + size.Y / 2 + inset.Y
        
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait()
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
        
        task.wait(2.5)
    end)
end

-- === CHECK IF IN CHARACTER (từ script kia) ===
local function isInCharacter(obj)
    local parent = obj.Parent
    while parent do
        if parent:FindFirstChild("Humanoid") then
            return true
        end
        parent = parent.Parent
    end
    return false
end

-- === LỤM TRÁI (tp handle - từ script kia) ===
local function BringFruit(tool)
    if not tool or not tool:IsA("Tool") then return end
    if not string.find(tool.Name, "Fruit") then return end
    if isInCharacter(tool) then return end
    
    local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    local handle = tool:FindFirstChild("Handle")
    
    if hrp and handle then
        handle.CFrame = hrp.CFrame + Vector3.new(0, 0, 0)
    end
end

-- === SCAN FRUITS (dùng FruitList + BringFruit) ===
local function ScanFruits()
    local found = 0
    pcall(function()
        for _, v in pairs(Workspace:GetDescendants()) do
            if v:IsA("Tool") and string.find(v.Name, "Fruit") then
                local isValid = false
                for _, fruitName in ipairs(CONFIG.FruitList) do
                    if string.find(v.Name, fruitName) or string.find(v.Name, string.gsub(fruitName, "-.*", "")) then
                        isValid = true
                        break
                    end
                end
                if isValid then
                    local success = BringFruit(v)
                    if success then
                        found = found + 1
                    end
                    task.wait(0.1)
                end
            end
        end
    end)
    return found
end

-- === STORE FRUITS (giữ nguyên từ script cũ) ===
local function StoreFruits()
    local stored = {}
    pcall(function()
        for _, v in pairs(plr.Backpack:GetChildren()) do
            if v:IsA("Tool") and string.find(v.Name, "Fruit") then
                local internal = FruitInternal[v.Name]
                if internal then
                    local success = Remote:InvokeServer("StoreFruit", internal, v)
                    if success then
                        table.insert(stored, v.Name)
                    end
                end
            end
        end
        
        if plr.Character then
            for _, v in pairs(plr.Character:GetChildren()) do
                if v:IsA("Tool") and string.find(v.Name, "Fruit") then
                    local internal = FruitInternal[v.Name]
                    if internal then
                        local success = Remote:InvokeServer("StoreFruit", internal, v)
                        if success then
                            table.insert(stored, v.Name)
                        end
                    end
                end
            end
        end
    end)
    return stored
end

