local function StoreFruits()
    pcall(function()
        local stored = {}
        
        for _, v in pairs(plr.Backpack:GetChildren()) do
            if v:IsA("Tool") and string.find(v.Name, "Fruit") then
                local success = Remote:InvokeServer("StoreFruit", v.Name)
                if success then
                    table.insert(stored, v.Name)
                end
            end
        end
        
        if plr.Character then
            for _, v in pairs(plr.Character:GetChildren()) do
                if v:IsA("Tool") and string.find(v.Name, "Fruit") then
                    local success = Remote:InvokeServer("StoreFruit", v.Name)
                    if success then
                        table.insert(stored, v.Name)
                    end
                end
            end
        end
        
        for _, fruitName in ipairs(stored) do
            if not table.find(fruitLog, fruitName) then
                table.insert(fruitLog, fruitName)
                SendWebhook(fruitName)
            end
        end
    end)
end

local function BringFruit(fruitModel)
    if not fruitModel or not fruitModel:IsA("Model") then return end
    local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local targetCF = hrp.CFrame + Vector3.new(0, 3, 3)
    pcall(function()
        if fruitModel.PrimaryPart then
            fruitModel:SetPrimaryPartCFrame(targetCF)
        else
            for _, part in pairs(fruitModel:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CFrame = targetCF
                end
            end
        end
    end)
end

local function ScanFruits()
    pcall(function()
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Model") and string.find(v.Name, "Fruit") then
                local isValid = false
                for _, fruitName in ipairs(CONFIG.FruitList) do
                    if string.find(v.Name, fruitName) or string.find(v.Name, string.gsub(fruitName, "-.*", "")) then
                        isValid = true
                        break
                    end
                end
                if isValid then
                    BringFruit(v)
                    task.wait(0.1)
                end
            end
        end
    end)
end

local function GetServerList()
    local servers = {}
    pcall(function()
        local http = game:GetService("HttpService")
        local response = http:GetAsync("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?limit=100")
        local data = http:JSONDecode(response)
        if data and data.data then
            for _, server in ipairs(data.data) do
                if server.id and server.id ~= game.JobId then
                    table.insert(servers, {
                        id = server.id,
                        count = server.playing or 0,
                        max = server.maxPlayers or 32
                    })
                end
            end
        end
    end)
    return servers
end

local function QueueTeleport(serverId)
    if isTeleporting then
        table.insert(teleportQueue, serverId)
        return
    end
    
    isTeleporting = true
    pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, serverId, plr)
    end)
    
    task.wait(2)
    isTeleporting = false
    
    if #teleportQueue > 0 then
        local nextServer = table.remove(teleportQueue, 1)
        task.wait(1)
        QueueTeleport(nextServer)
    end
end

local function AutoHop()
    if isHopping then return end
    isHopping = true
    
    UpdateStatus("🔄 Finding server...", Color3.fromRGB(255, 200, 0))
    
    local allServers = GetServerList()
    local candidates = {}
    
    for _, server in ipairs(allServers) do
        local isBlacklisted = false
        for _, bl in ipairs(blacklist) do
            if bl == server.id then
                isBlacklisted = true
                break
            end
        end
        if not isBlacklisted and server.count < server.max then
            table.insert(candidates, server)
        end
    end
    
    table.sort(candidates, function(a, b) return a.count < b.count end)
    
    if #candidates > 0 then
        local target = candidates[1]
        
        if game.JobId then
            table.insert(blacklist, game.JobId)
            if #blacklist > CONFIG.MaxBlacklist then
                blacklist = {}
            end
        end
        
        UpdateStatus("🚀 Hopping to server...", Color3.fromRGB(255, 100, 100))
        QueueTeleport(target.id)
    else
        UpdateStatus("⏳ No server found, retrying...", Color3.fromRGB(255, 100, 0))
        task.wait(3)
    end
    
    isHopping = false
end

local function MainProcess()
    SelectTeam()
    wait(1)
    
    CreateUI()
    UpdateStatus("✅ Ready", Color3.fromRGB(0, 255, 0))
    
    while task.wait(CONFIG.ScanInterval) do
        UpdateStatus("🔍 Scanning for fruits...", Color3.fromRGB(255, 255, 0))
        ScanFruits()
        
        UpdateStatus("📦 Storing fruits...", Color3.fromRGB(0, 200, 255))
        StoreFruits()
        
        UpdateStatus("✅ Collected complete", Color3.fromRGB(0, 255, 0))
        
        task.wait(CONFIG.HopDelay - CONFIG.ScanInterval)
        
        UpdateStatus("🔄 Preparing to hop...", Color3.fromRGB(255, 200, 0))
        AutoHop()
        
        task.wait(2)
    end
end

pcall(MainProcess)
