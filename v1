local function UpdateStatus(text, color)
    if statusLabel then
        statusLabel.Text = text
        if color then
            statusLabel.TextColor3 = color
        end
    end
end

local function MainProcess()
    LoadBlacklist()
    SelectTeam()
    CreateUI()
    UpdateStatus("✅ Ready", Color3.fromRGB(0, 255, 0))
        -- Scan fruits
        UpdateStatus("🔍 Scanning for fruits...", Color3.fromRGB(255, 255, 0))
        task.wait(2)
        local found = ScanFruits()

        if #found > 0 then
            UpdateStatus(
                "📦 Waiting for fruit...",
                Color3.fromRGB(0, 200, 255)
            )
        
            -- Cho fruit thời gian chuyển vào Backpack
            task.wait(1)
        
            local stored = storeAllFruits()
        
            -- Thử lại nếu lần đầu fruit chưa kịp vào inventory
            if #stored == 0 then
                task.wait(1)
                stored = storeAllFruits()
            end
        
            if #stored > 0 then
                for _, fruitName in ipairs(stored) do
                    if not table.find(fruitLog, fruitName) then
                        table.insert(fruitLog, fruitName)
                        collectedCount = collectedCount + 1
                        SendWebhook(fruitName)
                    end
                end
        
                UpdateStatus(
                    "✅ Stored " .. #stored .. " fruit(s)",
                    Color3.fromRGB(0, 255, 0)
                )
            else
                UpdateStatus(
                    "❌ Fruit found but store failed",
                    Color3.fromRGB(255, 100, 100)
                )
            end
        else
            UpdateStatus(
                "❌ No Fruit",
                Color3.fromRGB(255, 100, 100)
            )
        end
        task.wait(2.5)
        UpdateStatus("🔄 Hopping to new server...", Color3.fromRGB(255, 200, 0))
        TeleportToServer()
        task.wait(1)
end

pcall(MainProcess)
