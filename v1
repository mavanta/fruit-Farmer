-- === GET SERVER LIST ===
local function GetServerList()
    local servers = {}
    pcall(function()
        local response = HttpService:GetAsync("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?limit=100")
        local data = HttpService:JSONDecode(response)
        if data and data.data then
            for _, server in ipairs(data.data) do
                if server.id and server.id ~= game.JobId then
                    table.insert(servers, {
                        id = server.id,
                        count = server.playing or 0,
                        max = server.maxPlayers or 32
                    })
                end
            end
        end
    end)
    return servers
end


-- === QUEUE TELEPORT ===
local function QueueTeleport(serverId)
    if isTeleporting then
        table.insert(teleportQueue, serverId)
        return
    end
    
    isTeleporting = true
    local success = false
    pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, serverId, plr)
        success = true
    end)
    
    -- Timeout để không bị kẹt
    local start = tick()
    while isTeleporting and tick() - start < CONFIG.HopTimeout do
        task.wait(0.5)
    end
    isTeleporting = false
    
    if #teleportQueue > 0 then
        local nextServer = table.remove(teleportQueue, 1)
        task.wait(1)
        QueueTeleport(nextServer)
    end
end

-- === AUTO HOP ===
local function AutoHop()
    if isHopping then return end
    isHopping = true
    
    UpdateStatus("🔄 Finding server...", Color3.fromRGB(255, 200, 0))
    task.wait(0.5)
    
    local allServers = GetServerList()
    local candidates = {}
    
    for _, server in ipairs(allServers) do
        local isBlacklisted = false
        for _, bl in ipairs(blacklist) do
            if bl == server.id then
                isBlacklisted = true
                break
            end
        end
        if not isBlacklisted and server.count < server.max then
            table.insert(candidates, server)
        end
    end
    
    table.sort(candidates, function(a, b) return a.count < b.count end)
    
    if #candidates > 0 then
        local target = candidates[1]
        
        if game.JobId then
            table.insert(blacklist, game.JobId)
            if #blacklist > CONFIG.MaxBlacklist then
                local keep = {}
                for i = #blacklist - CONFIG.MaxBlacklist + 1, #blacklist do
                    table.insert(keep, blacklist[i])
                end
                blacklist = keep
            end
            SaveBlacklist()
        end
        
        UpdateStatus("🚀 Hopping to server... (" .. target.count .. "/" .. target.max .. ")", Color3.fromRGB(255, 100, 100))
        QueueTeleport(target.id)
    else
        UpdateStatus("⏳ No server found, retrying...", Color3.fromRGB(255, 100, 0))
        task.wait(3)
    end
    
    isHopping = false
end

