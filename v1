local function SaveBlacklist()
    pcall(function()
        if writefile then
            local data = table.concat(blacklist, "\n")
            writefile(CONFIG.BlacklistFile, data)
        end
    end)
end

local function LoadBlacklist()
    pcall(function()
        if not isfile or not readfile then
            warn("[ServerHop] Executor không hỗ trợ file API")
            return
        end

        if not isfile(CONFIG.BlacklistFile) then
            blacklist = {}
            return
        end

        local content = readfile(CONFIG.BlacklistFile)

        if not content or content == "" then
            blacklist = {}
            return
        end

        blacklist = {}

        for line in string.gmatch(content, "[^\r\n]+") do
            if line ~= "" and not table.find(blacklist, line) then
                table.insert(blacklist, line)
            end
        end

        -- Nếu file đã đủ 30 thì clear luôn
        if #blacklist >= CONFIG.MaxBlacklist then
            blacklist = {}
            SaveBlacklist()

            print("[ServerHop] Loaded blacklist was full -> cleared")
        end

        print(
            "[ServerHop] Loaded blacklist:",
            #blacklist
        )
    end)
end

local function SelectTeam()
    -- Bọc toàn bộ trong pcall để bắt mọi lỗi
    local success, err = pcall(function()
        if not game:IsLoaded() then
            game.Loaded:Wait()
        end
        task.wait(3)
        
        local realteam = getgenv().autoteam or "Pirates"
        local pg = plr:FindFirstChild("PlayerGui")
        
        -- Nếu không có PlayerGui thì thoát
        if not pg then
            return
        end
        
        local mainmal = pg:FindFirstChild("Main (minimal)")
        
        -- Nếu không có Main (minimal) thì thoát, không báo lỗi
        if not mainmal then
            return
        end
        
        local chooseTeam = mainmal:FindFirstChild("ChooseTeam")
        if not chooseTeam then
            return
        end
        
        local container = chooseTeam:FindFirstChild("Container")
        if not container then
            return
        end
        
        local teamContainer = container:FindFirstChild(realteam)
        if not teamContainer then
            return
        end
        
        local frame = teamContainer:FindFirstChild("Frame")
        if not frame then
            return
        end
        
        local chooseteambtn = frame:FindFirstChild("TextButton")
        if not chooseteambtn then
            return
        end
        
        -- Click button
        local inset = GuiService:GetGuiInset()
        local pos = chooseteambtn.AbsolutePosition
        local size = chooseteambtn.AbsoluteSize
        local x = pos.X + size.X / 2
        local y = pos.Y + size.Y / 2 + inset.Y
        
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait()
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
        
        task.wait(2.5)
    end)
    
    -- Nếu có lỗi, chỉ in ra console để debug, không ảnh hưởng script
    if not success then
        warn("⚠️ SelectTeam skipped: " .. tostring(err))
    end
end

local function isInCharacter(obj)
    local parent = obj.Parent
    while parent do
        if parent:FindFirstChild("Humanoid") then
            return true
        end
        parent = parent.Parent
    end
    return false
end

local function BringFruit(tool)
    if not tool or not tool:IsA("Tool") then return false end
    if not string.find(tool.Name, "Fruit") then return false end
    if isInCharacter(tool) then return false end
    
    local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    local handle = tool:FindFirstChild("Handle")
    
    if hrp and handle then
        handle.CFrame = hrp.CFrame + Vector3.new(0, 0, 0)
        return true
    end
    return false
end

local function ScanFruits()
    local found = {}

    pcall(function()
        for _, v in ipairs(Workspace:GetDescendants()) do
            if v:IsA("Tool") and string.find(v.Name, "Fruit") then

                local isValid = false

                for _, fruitName in ipairs(CONFIG.FruitList) do
                    local shortName = string.gsub(fruitName, "-.*", "")

                    if string.find(v.Name, fruitName)
                        or string.find(v.Name, shortName)
                    then
                        isValid = true
                        break
                    end
                end

                if isValid then
                    print("[FruitFarm] Found fruit:", v.Name)

                    if BringFruit(v) then
                        table.insert(found, v.Name)
                    end

                    task.wait(0.3)
                end
            end
        end
    end)

    return found
end

local function storeAllFruits()
    local stored = {}

    local function tryStore(tool)
        if not tool or not tool:IsA("Tool") then
            return
        end

        if not string.find(tool.Name, "Fruit") then
            return
        end

        local internal = FruitInternal[tool.Name]

        if not internal then
            warn("[FruitFarm] Missing internal name:", tool.Name)
            return
        end

        local success, result = pcall(function()
            return Remote:InvokeServer("StoreFruit", internal, tool)
        end)

        if success and result then
            table.insert(stored, tool.Name)

            print(
                "[FruitFarm] Stored:",
                tool.Name
            )
        else
            warn(
                "[FruitFarm] Store failed:",
                tool.Name,
                tostring(result)
            )
        end
    end

    for _, tool in ipairs(plr.Backpack:GetChildren()) do
        tryStore(tool)
    end

    if plr.Character then
        for _, tool in ipairs(plr.Character:GetChildren()) do
            tryStore(tool)
        end
    end

    return stored
end

